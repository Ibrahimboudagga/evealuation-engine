# Database
DATABASE_URL=sqlite:///evals.db
APP_ENVIRONMENT=development
# In production use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://evaluation:change-me@db:5432/evaluation

# Provider API keys. A real provider requires its key; choose provider/model "mock" for demo mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# Required before saving workspace-level provider connections. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKSPACE_ENCRYPTION_KEY=

# Optional token for the single-user Gradio deployment. Create the first owner
# through POST /auth/bootstrap, save its returned token here, then restart Gradio.
WORKSPACE_API_TOKEN=

# Public documentation link surfaced by /health for operators.
BACKUP_GUIDANCE_URL=https://www.postgresql.org/docs/current/backup.html

# Evaluation defaults
DEFAULT_CANDIDATE_PROVIDER=mock
DEFAULT_CANDIDATE_MODEL=mock
DEFAULT_EVALUATOR_PROVIDER=mock
DEFAULT_EVALUATOR_MODEL=mock
DEFAULT_CONCURRENCY=3

# Semantic similarity
SIMILARITY_MODEL_NAME=all-MiniLM-L6-v2
