# Database
DATABASE_URL=sqlite:///evals.db

# Provider API keys. Leave blank to use mock providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# Evaluation defaults
DEFAULT_CANDIDATE_PROVIDER=openai
DEFAULT_CANDIDATE_MODEL=mock
DEFAULT_EVALUATOR_PROVIDER=openai
DEFAULT_EVALUATOR_MODEL=mock
DEFAULT_CONCURRENCY=3

# Semantic similarity
SIMILARITY_MODEL_NAME=all-MiniLM-L6-v2
