# Database
DATABASE_URL=sqlite:///evals.db

# Provider API keys. A real provider requires its key; choose provider/model "mock" for demo mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# Evaluation defaults
DEFAULT_CANDIDATE_PROVIDER=mock
DEFAULT_CANDIDATE_MODEL=mock
DEFAULT_EVALUATOR_PROVIDER=mock
DEFAULT_EVALUATOR_MODEL=mock
DEFAULT_CONCURRENCY=3

# Semantic similarity
SIMILARITY_MODEL_NAME=all-MiniLM-L6-v2
